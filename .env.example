# Local development only. Supabase replaces this URL when deploying.
DATABASE_URL=sqlite+pysqlite:///./data/patients.db
APP_ENV=development
LOG_LEVEL=INFO

# Optional locally; required when APP_ENV=production. Use a randomly generated token.
# Send it as Authorization: Bearer <token> on patient endpoints.
API_AUTH_TOKEN=

# Voice webhook authentication is separate from the patient REST API token.
VAPI_WEBHOOK_SECRET=
# In Vapi Integrations > Server Configuration, create a Bearer credential using
# VAPI_WEBHOOK_SECRET. Put its non-secret ID below once created.
VAPI_SERVER_CREDENTIAL_ID=
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_MODEL=gemini-2.5-flash
# Intentionally public browser SDK key, restricted in Vapi to this assistant/site.
VAPI_PUBLIC_KEY=
